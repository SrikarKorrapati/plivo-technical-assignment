# Slack: Bot User OAuth Token (OAuth & Permissions page, after installing the app)
SLACK_BOT_TOKEN=xoxb-...
# Slack: App-Level Token with connections:write (Basic Information > App-Level Tokens)
SLACK_APP_TOKEN=xapp-...
# Replicate: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=r8_...
# Your trained model, "owner/name:version" (printed by train.py when training succeeds)
REPLICATE_MODEL=your-username/down-memory-lane:VERSION_ID
# The trigger word you trained with
TRIGGER_WORD=TOK
# How strongly the LoRA (your face) is applied. Lower lets the age change more; higher keeps identity.
LORA_SCALE=0.8
# Age-independent traits from the training photos (no glasses/beard), keeps the likeness
SUBJECT_DESCRIPTION=warm brown skin, dark brown eyes, black hair
# "boy" or "girl"; keeps the child's gender consistent
SUBJECT_GENDER=boy
